{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "/",
  "packages": {
    "rust": {
      "release-type": "rust",
      "component": "rust"
    },
    "python": {
      "release-type": "python",
      "component": "python",
      "extra-files": ["src/topstepx/_version.py"]
    },
    "go": {
      "release-type": "go",
      "component": "go",
      "extra-files": ["version.go"]
    }
  }
}
